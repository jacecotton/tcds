{% set _classes = ["tcds-quick-links", classes|default("")] %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

<ul {{ attributes }} role="list">
  {% for link in links %}
    <li>
      <a href="{{ link.url }}">
        {% if link.icon %}
          <tcds-icon icon="{{ link.icon }}" preserve-color></tcds-icon>
        {% elseif link.image %}
          <img {{ create_attribute(link.image|merge({role: "presentation"}))  }}>
        {% endif %}
        <span>{{ link.text }} <tcds-icon icon="caret-right-thin"></tcds-icon></span>
      </a>
    </li>
  {% endfor %}
</ul>
