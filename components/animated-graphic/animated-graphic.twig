{% set base_class = "tcds-animated-graphic" %}
{% set _classes = [base_class, classes|default("")]|join(" ") %}
{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}
{% set attributes = attributes.setAttribute("data-theme", theme|default("default")) %}
<figure {{ attributes }}>
  <video autoplay muted loop playsinline src="{{ src }}"></video>
  <button class="tcds-button tcds-button--media" title="Toggle play state">
    <span class="visually-hidden">Toggle play state</span>
    <tcds-icon icon="pause"></tcds-icon>
  </button>
</figure>
