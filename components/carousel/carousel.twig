{% set attributes = attributes|default(create_attribute()) %}

{% set attributes = attributes
  .addClass(classes|default([]))
  .setAttribute("playing", playing|default(false))
  .setAttribute("interval", interval|default(false))
  .setAttribute("controls", controls|default(false))
  .setAttribute("no-pause-on-hover", no_pause_on_hover|default(false))
%}

<tcds-carousel {{ attributes }}>
  {% if slides is defined and slides is iterable and slides is not empty %}
    {% for slide in slides %}
      {% set content = null %}

      {% if slide.content is defined %}
        {% if slide.content is not iterable and block(slide.content) is defined %}
          {% set content = block(slide.content) %}
        {% else %}
          {% set content = slide.content %}
        {% endif %}
      {% endif %}

      {{ include("@tcds/slide/slide.twig", {
        content: content,
        attributes: slide.attributes|default(create_attribute()),
        classes: slide_classes|default([]),
      }, with_context=false) }}
    {% endfor %}
  {% else %}
    {% block slides %}{{ slides }}{% endblock %}
  {% endif %}
</tcds-carousel>
