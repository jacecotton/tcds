{% set attributes = create_attribute(attributes|default({}))
  .setAttribute("selected", selected|default(false))
%}

<tcds-tab {{ attributes }}>
  <{{ heading_level }} slot="title" id="{{ title|clean_unique_id }}">{{ title }}</{{ heading_level }}>
  {% if content is defined %}
    {% if content is not iterable and block(content) is defined %}
      {{ block(content) }}
    {% else %}
      {% block content %}
        {{ content }}
      {% endblock %}
    {% endif %}
  {% endif %}
</tcds-tab>
