{%- set attributes = create_attribute(attributes|default({}))
  .setAttribute("id", text|default(false) ? text|clean_id : false)
  .setAttribute("style", measure|default(false) ? "max-width: #{measure}ch" : false)
-%}

{%- set heading_level = heading_level|default("h2") -%}

<{{ heading_level }} {{ attributes }}>{{ text }}</{{ heading_level }}>
