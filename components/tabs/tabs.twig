{% set attributes = create_attribute(attributes|default({}))
  .setAttribute("media", media|default(false))
  .setAttribute("label", label|default(false))
%}

<tcds-tabs {{ attributes }}>
  {% if tabs is defined and tabs is iterable %}
    {% for tab in tabs %}
      {% set tab_content = tab.content|default("") %}
      {% if (tab_content starts with "") and block(tab_content) is defined %}
        {% set tab_content = block(tab_content) %}
      {% endif %}

      {{ include("tcds:tab", {
        title: tab.title,
        content: tab_content,
        selected: tab.selected,
        heading_level: heading_level|default(null),
        attributes: create_attribute(tab_attributes|default({})|merge(tab.attributes|default({}))),
      }) }}
    {% endfor %}
  {% endif %}

  {% block content %}
    {{ content|default("") }}
  {% endblock %}
</tcds-tabs>
