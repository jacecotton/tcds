{% set base_class = "tcds-pullout-menu" %}
{% set attributes = create_attribute(attributes|default({}))
  .addClass(base_class)
  .setAttribute("open", open|default(false))
%}

<details {{ attributes }}>
  <summary class="tcds-pullout-menu__toggle">{{ title }}</summary>
  <ul class="tcds-pullout-menu__list">
    {% for link in links %}
      <li {{ create_attribute(link_attributes|default({}))
        .addClass("#{base_class}__item")
      }}>
        <a {{ create_attribute(link.attributes|default({}))
          .setAttribute("href", link.url)
          .addClass(["#{base_class}__link", link.is_active ? "#{base_class}__link--active"])
        }}>
          {% if link.before_text %}
            <span class="tcds-pullout-menu__before-text">{{ link.before_text }}</span>
          {% endif %}
          <span class="tcds-pullout-menu__text">{{ link.text }}</span>
          {% if link.after_text %}
            <span class="tcds-pullout-menu__after-text">{{ link.after_text }}</span>
          {% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
</details>
