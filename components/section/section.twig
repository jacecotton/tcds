{% set base_class = "tcds-section" %}
{% set _classes = [base_class, modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")|join(" "), classes|default("")]|join(" ") %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("data-theme", theme|default("default")) %}

<section {{ attributes }}>
  {% if background_images %}
    {% for image in background_images %}
      <img {{ create_attribute(image|merge({
        alt: "",
        role: "presentation",
      })) }}>
    {% endfor %}
  {% endif %}
  {% if background_video %}
    <video {{ create_attribute(background_video|merge({
      loop: true,
      autoplay: true,
      muted: true,
    })) }}></video>
  {% endif %}
  <div class="container-lg">
    {% block content %}
      {{ content }}
    {% endblock %}
  </div>
</section>
