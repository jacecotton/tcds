{% set base_class = "tcds-cta" %}
{% set _classes = ["tcds-cta", modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")|join(" "), classes|default("")]|join(" ") %}
{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}
{%- if url -%}
{%- set attributes = attributes.setAttribute("href", url) -%}
<a {{ attributes }}>{{ text }}</a>
{%- endif -%}
