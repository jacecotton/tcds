{%- apply spaceless -%}
{% set base_class = "tcds-cta" %}
{% set _classes = [base_class, classes|default("")] %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("href", href) %}

{% if variant is defined and variant != "primary" %}
  {% set attributes = attributes.setAttribute("data-variant", variant) %}
{% endif %}
{%- endapply -%}
<a {{ attributes }}>{{ text }}</a>
