{% set base_class = "tcds-callout" %}

{% set _classes = [base_class]|merge(classes|default([])) %}

{% set _classes = _classes|merge(
  modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")
) %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("theme", theme|default("cool")) %}

<div {{ attributes }}>
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
