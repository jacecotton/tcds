{% set base_class = "tcds-callout" %}
{% set _classes = [base_class, classes|default("")]|join(" ") %}

{% set _classes = _classes ~ " " ~ modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")|join(" ") %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("data-theme", theme|default("cool")) %}

<div {{ attributes }}>
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
