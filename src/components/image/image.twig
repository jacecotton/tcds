{% set _classes = ["", classes|default("")] %}
{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% if image is defined and image is iterable %}
  {% set attributes = attributes.merge(create_attribute(image)) %}
{% endif %}

{% if fit %}
  {% set attributes = attributes.setAttribute("style", "object-fit: #{fit};") %}
{% endif %}

{% set content %}
  <img {{ attributes }}>
{% endset %}

{% if caption %}
  <figure>
    {{ content }}
    <figcaption>{{ caption|raw }}</figcaption>
  </figure>
{% else %}
  {{ content }}
{% endif %}
