{% set base_class = "tcds-section" %}
{% set _classes = [base_class, classes|default("")]|join(" ") %}

{% set _classes = _classes ~ " " ~ modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")|join(" ") %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("data-theme", theme|default("neutral")) %}

{% if background_image_interval and background_images|length %}
  {% set attributes = attributes.setAttribute("data-interval", background_image_interval) %}
{% endif %}

<section {{ attributes }}>
  {% if background_images %}
    {% for image in background_images %}
      <img {{ create_attribute(image|merge({
        alt: "",
        role: "presentation",
      })) }}>
    {% endfor %}
  {% endif %}
  <div class="container-lg">
    {% block content %}
      {{ content }}
    {% endblock %}
  </div>
</section>
