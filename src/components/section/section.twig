{% set base_class = "tcds-section" %}
{% set _classes = [base_class, modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")|join(" "), classes|default("")]|join(" ") %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("data-theme", theme|default("default")) %}

<section {{ attributes }}>
  {% if background_images %}
    {% for image in background_images %}
      {% if image.default %}
        <picture>
          {% if image.desktop and image.desktop.src %}
            <source {{ create_attribute(image.desktop|merge({
              media: "(min-width: 960px)",
              srcset: image.desktop.src,
              src: false,
            })) }}>
          {% endif %}
          <img {{ create_attribute(image.default|merge({
            alt: "",
            role: "presentation",
          })) }}>
        </picture>
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if background_video %}
    <video {{ create_attribute(background_video|merge({
      loop: true,
      autoplay: true,
      muted: true,
    })) }}></video>
  {% endif %}
  <div class="container-lg">
    {% block content %}
      {{ content }}
    {% endblock %}
  </div>
</section>
