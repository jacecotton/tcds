{% set attributes = create_attribute(attributes|default({}))
  .setAttribute("open", open|default(false))
%}

<tcds-accordion-section {{ attributes }}>
  <{{ heading_level }} slot="title">{{ title }}</{{ heading_level }}>
  {% if content is defined %}
    {% if content is not iterable and block(content) is defined %}
      {{ block(content) }}
    {% else %}
      {% block content %}
        {{ content }}
      {% endblock %}
    {% endif %}
  {% endif %}
</tcds-accordion-section>
