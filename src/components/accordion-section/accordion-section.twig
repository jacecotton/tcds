{% set _classes = []|merge(classes|default([])) %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("open", open ? true : false) %}

{% set heading_level = heading_level|default("h3") %}

<tcds-accordion-section {{ attributes }}>
  <{{ heading_level }} slot="title">{{ title }}</{{ heading_level }}>
  {% if content is defined %}
    {% if content is not iterable block(content) is defined %}
      {{ block(content) }}
    {% else %}
      {{ content }}
    {% endif %}
  {% endif %}
</tcds-accordion-section>
