{% embed "@tcds/section/section.twig" with {
  classes: "tcds-hero-immersive",
  background_images: background_images,
  theme: theme|default("dark"),
  modifiers: modifiers|default(null),
  heading: heading,
  eyebrow: eyebrow,
  lead: lead,
  links: links,
} only %}
  {% block content %}
    <div class="tcds-hero-immersive__content" data-theme="default">
      {% set display_element %}
        <p class="text-display-2">{{ heading }}</p>
      {% endset %}

      {% if eyebrow and heading %}
        <hgroup>
          <h1>{{ eyebrow }}</h1>
          {{ display_element }}
        </hgroup>
      {% elseif heading %}
        {{ display_element }}
      {% endif %}

      <div style="max-width: 70ch">
        {{ lead }}
      </div>
    </div>
  {% endblock %}
{% endembed %}
