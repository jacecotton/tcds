{% set year = year|default("now"|date("Y")) %}
{% set site_name = site_name|default("Texas Children's") %}
{% set transparency_menu = transparency_menu|default([]) %}

<footer class="tcds-site-footer">
  <div class="container-lg">
    <div class="tcds-site-footer__branding">
      <a href="/" rel="home" title="Go home" slot="logo">
        <img src="{{ logo.url }}" alt="{{ logo.alt ?: "Texas Children's logo" }}" width="{{ logo.width ?: "250" }}" height="{{ logo.height ?: "33.16" }}">
      </a>
    </div>

    {% if transparency_menu|length %}
      <nav class="tcds-site-footer__transparency-menu">
        <ul role="list">
          {% for item in transparency_menu %}
            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if legal_disclaimer %}
      <p class="tcds-site-footer__legal">
        <small>{{ legal_disclaimer }}</small>
      </p>
    {% endif %}

    <p class="tcds-site-footer__copyright">
      <small>&copy; {{ year }} {{ site_name }}</small>
    </p>
  </div>
</footer>
