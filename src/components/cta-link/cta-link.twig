{%- apply spaceless -%}
{% set attributes = attributes|default(create_attribute()) %}
{% set base_class = "tcds-cta-link" %}

{% set attributes = attributes
  .addClass(classes|default([]))
  .addClass([base_class]|merge(modifiers|default([])|map(modifier => "#{base_class}--#{modifier}")))
  .setAttribute("href", url|default(false))
%}

{%- set icon_element -%}
  {%- if icon -%}
    <tcds-icon icon="{{ icon }}" aria-hidden="true"></tcds-icon>
  {%- endif -%}
{%- endset -%}
{%- endapply -%}
<a {{ attributes }}>{{ text }}{{ icon_element }}</a>
