{% set _classes = []|merge(classes|default([])) %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% if variant %}
  {% set attributes = attributes.setAttribute("variant", variant) %}
{% endif %}

{% set title_element = heading_level|default(link ? "a" : "p") %}

<tcds-card {{ attributes }}>
  {% if image or block("figure") %}
    <figure slot="image">
      {% block figure %}{% endblock %}
      {%- if image.src -%}
        <img {{ create_attribute(image) }}>
      {%- endif -%}
    </figure>
  {% endif %}
  {% if meta %}
    <p slot="meta">
      {% if meta is iterable %}
        {% for item in meta %}
          <small>{{ meta }}</small>
        {% endfor %}
      {% else %}
        <small>{{ meta }}</small>
      {% endif %}
    </p>
  {% endif %}
  <{{ title_element }} slot="title" {{ title_element == "a" ? "href=\"#{link}\"" }}>
    {% if link and title_element != "a" %}
      <a href="{{ link }}">{{ title }}</a>
    {% else %}
      {{ title }}
    {% endif %}
  </{{ title_element }}>
  {% if description %}
    <p slot="description">{{ description }}</p>
  {% endif %}
</tcds-card>
