{% set _classes = ["", classes|default("")] %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% if variant is defined and variant and variant != "none" %}
  {% set attributes = attributes.setAttribute("variant", variant) %}
{% endif %}

{% if size is defined and size and size != "none" %}
  {% set attributes = attributes.setAttribute("size", size) %}
{% endif %}

{% if orientation is defined and orientation and orientation != "auto" %}
  {% set attributes = attributes.setAttribute("orientation", orientation) %}
{% endif %}

{% set link = {
  href: link_href|default(false),
  text: link_text|default(false),
} %}

{% set title_element = heading_level is defined and heading_level and heading_level != "none" ? heading_level : (link.href ? "a" : "p") %}

<tcds-card {{ attributes }}>
  {%- if image is defined or block("figure") is defined -%}
    <figure slot="image">
      {%- block figure -%}{{ figure }}{%- endblock -%}
      {%- if image.src -%}
        <img {{ create_attribute(image) }}>
      {%- endif -%}
    </figure>
  {%- endif -%}
  {% if tag is defined %}
    <small slot="tag">
      {{ tag }}
    </small>
  {% endif %}
  {% if meta is defined %}
    <small slot="meta">
      {% if meta is iterable %}
        {% for item in meta %}
          <span>{{ item }}</span>
        {% endfor %}
      {% else %}
        {{ meta }}
      {% endif %}
    </small>
  {% endif %}
  <{{ title_element }} slot="title" {{ title_element == "a" ? "href=\"#{link.href}\""|raw }}>
    {% if link.href and title_element != "a" %}
      <a href="{{ link.href }}">{{ title }}</a>
    {% else %}
      {{ title }}
    {% endif %}
  </{{ title_element }}>
  {% if description %}
    <p slot="description">{{ description }}</p>
  {% endif %}
  {% if block("footer") %}
    <footer slot="footer">
      {% block footer %}{{ footer }}{% endblock %}
    </footer>
  {% endif %}
</tcds-card>
