{% set _classes = []|merge(classes|default([])) %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% if variant %}
  {% set attributes = attributes.setAttribute("variant", variant) %}
{% endif %}

{% set title_element = heading_level|default(link and link.url ? "a" : "p") %}

<tcds-card {{ attributes }}>
  {%- if image or block("figure") -%}
    <figure slot="image">
      {%- block figure -%}{%- endblock -%}
      {%- if image.src -%}
        <img {{ create_attribute(image) }}>
      {%- endif -%}
    </figure>
  {%- endif -%}
  {% if tag %}
    <small slot="tag">
      {{ tag }}
    </small>
  {% endif %}
  {% if meta %}
    <small slot="meta">
      {% if meta is iterable %}
        {% for item in meta %}
          <span>{{ meta }}</span>
        {% endfor %}
      {% else %}
        {{ meta }}
      {% endif %}
    </small>
  {% endif %}
  <{{ title_element }} slot="title" {{ title_element == "a" ? "href=\"#{link.url}\"" }}>
    {% if link and link.url and title_element != "a" %}
      <a href="{{ link.url }}">{{ title }}</a>
    {% else %}
      {{ title }}
    {% endif %}
  </{{ title_element }}>
  {% if description %}
    <p slot="description">{{ description }}</p>
  {% endif %}
  {% if block("footer") %}
    <footer slot="footer">
      {% block footer %}{% endblock %}
    </footer>
  {% endif %}
</tcds-card>
