{% set base_class = "grid-item" %}

{% set column_sizes = column_sizes|default({
  default: column_size|default("1/1"),
  sm: column_size_sm|default("inherit"),
  md: column_size_md|default("inherit"),
  lg: column_size_lg|default("inherit"),
}) %}

{% set attributes = create_attribute(attributes|default({}))
  .addClass(base_class)
  .addClass(column_sizes|map((size, breakpoint) => (breakpoint == "default" ? "" : "#{breakpoint}:") ~ "grid-item" ~ (size == "inherit" ? "" : "--#{size}")))
  .setAttribute()
%}

<div {{ attributes }}>
  {% block content %}
    {{ content|default("") }}
  {% endblock %}
</div>
