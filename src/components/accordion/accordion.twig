{% set _classes = ["", classes|default("")] %}

{% set attributes = attributes|default(create_attribute()) %}
{% set attributes = attributes.addClass(_classes) %}

{% set attributes = attributes.setAttribute("multiple", multiple|default(false)) %}

<tcds-accordion {{ attributes }}>
  {% if sections is defined and sections is iterable and sections[0] is defined %}
    {# Not a render array (i.e. slot), sections are coming in as a flat object. #}
    {% for section in sections %}
      {% if section.content is defined %}
        {% if section.content is not iterable and block(section.content) is defined %}
          {# section.content is just a pure string (not iterable) and is the
          name of a block #}
          {% set content = block(section.content) %}
        {% else %}
          {# Possibly iterable or not the name of a block, just pass through #}
          {% set content = section.content %}
        {% endif %}
      {% endif %}

      {{ include("tcds:accordion-section", {
        title: section.title,
        content: content,
        open: section.open == true,
        heading_level: heading_level ?: null,
      }) }}
    {% endfor %}
  {% else %}
    {# Render array/slot, dump here #}
    {% block sections %}{{ sections }}{% endblock %}
  {% endif %}
</tcds-accordion>
