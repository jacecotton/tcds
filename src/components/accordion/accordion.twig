{% set attributes = create_attribute(attributes|default({}))
  .setAttribute("multiple", multiple|default(false))
  .setAttribute("media", media|default(false))
%}

<tcds-accordion {{ attributes }}>
  {% if sections is defined and sections is iterable %}
    {% for section in sections %}
      {% set section_content = section.content|default("") %}

      {# `content` is an embedded block. #}
      {% if (section_content starts with "") and block(section_content) is defined %}
        {% set section_content = block(section_content) %}
      {% endif %}

      {{ include("@tcds/accordion-section/accordion-section.twig", {
        title: section.title,
        content: section_content,
        open: section.open|default(false),
        heading_level: heading_level|default(null),
        attributes: create_attribute(section_attributes|default({})|merge(section.attributes|default({}))),
      }) }}
    {% endfor %}
  {% endif %}

  {% block content %}
    {{ content|default("") }}
  {% endblock %}
</tcds-accordion>
