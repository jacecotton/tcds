{% set attributes = attributes|default(create_attribute()) %}

{% if theme == "dark" %}
  {% set attributes = attributes.setAttribute("data-theme", "dark") %}
{% endif %}

{% set logo = logo|default({
  link: {
    href: logo_link_href|default("/"),
    title: logo_link_title|default("Go home"),
  },
  image: logo_image|default({}),
}) %}

<tcds-site-header {{ attributes }}>
  <a href="{{ logo.link.href }}" rel="home" title="{{ logo.link.title }}" slot="logo">
    <img {{ create_attribute(logo.image) }}>
    {% if logo.entity %}
      <span>{{ logo.entity }}</span>
    {% endif %}
  </a>

  <details slot="menus">
    <summary>
      <span class="visually-hidden">Toggle main navigation</span>
    </summary>
    <div>
      {% if primary_menu is defined and primary_menu is iterable and primary_menu[0] is defined %}
        <nav data-part="primary-menu">
          <ul role="list">
            {% for item in primary_menu %}
              <li>
                {% if item.url is defined %}
                  <a href="{{ item.url }}">{{ item.title }}</a>
                {% elseif item.content is defined %}
                  <details name="primary-menu">
                    <summary>{{ item.title }}</summary>
                    <div>
                      {% if block(item.content) is defined %}
                        {{ block(item.content) }}
                      {% else %}
                        {{ item.content }}
                      {% endif %}
                    </div>
                  </details>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% else %}
        {% block primary_menu %}{{ primary_menu }}{% endblock %}
      {% endif %}

      {% if utility_menu is defined and utility_menu is iterable and utility_menu[0] is defined %}
        <nav data-part="utility-menu">
          <ul role="list">
            {% for item in utility_menu %}
              <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% else %}
        {% block utility_menu %}{{ utility_menu }}{% endblock %}
      {% endif %}
    </div>
  </details>

  {% if search_menu is defined %}
    <details slot="search" name="primary-menu">
      <summary>
        <span class="visually-hidden">Toggle main search</span>
      </summary>
      <div>
        {% if block(search_menu) is defined %}
          {{ block(search_menu) }}
        {% else %}
          {{ search_menu }}
        {% endif %}
      </div>
    </details>
  {% endif %}
</tcds-site-header>
