{% set attributes = create_attribute(attributes|default({}))
  .setAttribute("data-theme", theme|default(false))
%}

<tcds-animated-graphic {{ attributes }}>
  {% set video_attributes = create_attribute(video_attributes|default({}))
    .setAttribute("autoplay", true)
    .setAttribute("muted", true)
    .setAttribute("loop", true)
    .setAttribute("playsinline", true)
    .setAttribute("src", src)
  %}
  <video {{ video_attributes }}></video>
</tcds-animated-graphic>
