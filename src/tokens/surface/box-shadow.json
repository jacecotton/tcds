{
  "box-shadow": {
    "$type": "shadow",
    "soft": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "20px",
        "color": "rgb(0 0 0 / 15%)"
      }
    },
    "medium": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "3px",
        "blur": "12px",
        "color": "rgb(0 0 0 / 15%)"
      }
    },
    "hard": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "4px",
        "color": "rgb(0 0 0 / 25%)"
      }
    }
  }
}
