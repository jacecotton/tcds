{
  "font": {
    "stack": {
      "$type": "fontFamily",
      "sans-serif": {
        "$description": "Our secondary font stack.",
        "$value": ["Mont", "system-ui", "sans-serif"]
      },
      "serif": {
        "$description": "Our primary font stack.",
        "$value": ["Calluna", "Palatino", "serif"]
      }
    },
    "family": {
      "$type": "fontFamily",
      "primary": {
        "$description": "Display text (headlines, taglines)",
        "$value": "{font.stack.serif}"
      },
      "headings": {
        "$description": "Heading elements (H1 and H2)",
        "$value": "{font.stack.serif}"
      },
      "copy": {
        "$description": "Body copy (paragraphs, lists)",
        "$value": "{font.stack.serif}"
      },
      "secondary": {
        "$description": "Secondary text (headline lockups)",
        "$value": "{font.stack.sans-serif}"
      },
      "subheadings": {
        "$description": "Subheading elements (H3 through H6)",
        "$value": "{font.stack.sans-serif}"
      },
      "ui": {
        "$description": "Interface elements (buttons, labels)",
        "$value": "{font.stack.sans-serif}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "normal": {"$value": 400},
      "semibold": {"$value": 600},
      "bold": {"$value": 700}
    },
    "size": {
      "$type": "dimension",
      "xs": {"$value": "0.8125rem"},
      "sm": {"$value": "0.875rem"},
      "md": {"$value": "1rem"},
      "ml": {"$value": "1.125rem"},
      "lg": {"$value": "1.3rem"},
      "xl": {"$value": "1.875rem"},
      "2xl": {"$value": "2.375rem"},
      "3xl": {"$value": "3rem"},
      "4xl": {"$value": "4rem"},
      "5xl": {"$value": "6rem"}
    }
  }
}
