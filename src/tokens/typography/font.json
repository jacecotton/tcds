{
  "font": {
    "stack": {
      "$type": "fontFamily",
      "sans-serif": {
        "$description": "Our sans-serif font stack.",
        "$value": ["Poppins", "system-ui", "sans-serif"]
      },
      "serif": {
        "$description": "Our serif font stack.",
        "$value": ["Fraunces", "serif"]
      }
    },
    "family": {
      "$type": "fontFamily",
      "display": {
        "$description": "Bold, pronounced headings",
        "$value": "{font.stack.serif}"
      },
      "body": {
        "$description": "Body copy (paragraphs, lists)",
        "$value": "{font.stack.sans-serif}"
      },
      "ui": {
        "$description": "Interface elements (buttons, labels)",
        "$value": "{font.stack.sans-serif}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "display": {"$value": 700},
      "body": {"$value": 400},
      "ui": {"$value": 600}
    },
    "size": {
      "$type": "dimension",
      "xs": {"$value": "0.75rem"},
      "sm": {"$value": "0.875rem"},
      "md": {"$value": "1rem"},
      "lg": {"$value": "1.125rem"},
      "xl": {"$value": "1.25rem"},
      "2xl": {"$value": "1.5rem"},
      "4xl": {"$value": "2.25rem"},
      "5xl": {"$value": "3rem"},
      "6xl": {"$value": "3.75rem"},
      "7xl": {"$value": "4.5rem"},
      "8xl": {"$value": "6rem"},
      "9xl": {"$value": "8rem"}
    }
  }
}
