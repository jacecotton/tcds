<style>
.dont-do {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--tcds-space-component-lg);
  margin-bottom: var(--tcds-space-component-lg);
}
.dont-do article {
  display: inline-block;
  overflow: hidden;
}
.dont-do figure {
  width: 100%;
  aspect-ratio: 2 / 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  background: var(--tcds-color-theme-faded);
  border-top-right-radius: var(--tcds-border-radius-lg);
  border-top-left-radius: var(--tcds-border-radius-lg);
  overflow: hidden;
  padding: var(--tcds-space-component-md);
}
.dont-do figure pre {
  border: 0;
  padding: 0;
  width: 100%;
}
.dont-do footer {
  padding: var(--tcds-space-component-sm) 0 0 0;
  font-family: var(--tcds-font-family-ui);
  font-size: var(--tcds-font-size-sm);
}
.dont-do footer span {
  display: block;
  border-bottom: 1px solid var(--tcds-color-theme-edge);
  margin-bottom: .5em;
  font-size: var(--tcds-font-size-md);
}
.dont-do footer tcds-icon {
  margin-right: .25rem;
}
</style>
<div class="dont-do" data-theme="neutral">
{% if dont %}
<article>
<figure>{% block dont %}{% endblock %}</figure>
<footer>
<p>
<span><tcds-icon icon="close" style="color: red"></tcds-icon> <b>Don't</b></span>{{ dont }}
</p>
</footer>
</article>
{% endif %}
{% if do_this %}
<article>
<figure>{% block do_this %}{% endblock %}</figure>
<footer>
<p>
<span><tcds-icon icon="check" style="color: green"></tcds-icon> <b>Do</b></span>
{{ do_this }}
</p>
</footer>
</article>
{% endif %}
</div>
