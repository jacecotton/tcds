{% set breadcrumbs = collections.all|eleventyNavigationBreadcrumb(eleventyNavigation.key) %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{
    [title|default, eleventyNavigation.parent|default]
      |filter(v => v is not empty and v != site.name)
      |merge([site.name])
      |join(" - ")
  }}</title>

  <meta name="description" content="{{ description ?: site.description }}">

  <link rel="stylesheet" href="/tcds/dist/css/icons.css">
  <link rel="stylesheet" href="/tcds/dist/css/tcds.css">
  <link rel="stylesheet" href="/dist/css/site.css">
  <link rel="stylesheet" href="/dist/css/playground.css">
  <link rel="stylesheet" href="/dist/css/example.css">
  <link rel="stylesheet" href="/dist/css/sugar-high.css">

  {% for asset in get_assets() %}
    {% if asset ends with ".css" %}
      <link rel="stylesheet" href="{{ asset }}">
    {% endif %}
  {% endfor %}
</head>
<body>
  {% block body %}
    {{ include("tcds:site-header", {
      logo: {
        url: "/tcds/dist/images/logos/TC_Horz_CMYK_2K22.svg",
        width: "250",
        height: "33.16",
        alt: "Texas Children's logo",
        entity: "Design System",
      },
      primary_menu: collections.all|eleventyNavigation,
    }) }}

    {# @todo replace with content-page-hero component #}
    {% embed "tcds:section" with {
      theme: "dark",
      modifiers: ["raised"],
      classes: "bg-icon bg-icon--texas-childrens",
    } %}
      {% block content %}
        <div class="content-page-hero__heading">
          {{ include("tcds:breadcrumb", {
            items: breadcrumbs,
            backlink_only: true,
          }) }}
          <h1>{{ title }}</h1>
        </div>
        <p>{{ description }}</p>
      {% endblock %}
    {% endembed %}

    <div class="container-lg flex flex--no-wrap gap-md padding-block-sm lg:padding-block-md">
      {% set parent_key = eleventyNavigation.parent|default(eleventyNavigation.key) %}
      {% set nav_tree = collections.all|eleventyNavigation|filter(item => item.key == parent_key)|first %}
      {% set submenu = nav_tree is not empty ? [nav_tree] %}

      {% if submenu %}
        <aside style="min-width: 280px">
          {{ include("tcds:submenu", {items: submenu, current: page.url}) }}
        </aside>
      {% endif %}
      <main>
        {{ content|raw }}
      </main>
    </div>

    {{ include("tcds:site-footer", {
      logo: {
        url: "/tcds/dist/images/logos/TC_Horz_CMYK_2K22.svg",
        width: "250",
        height: "33.16",
        alt: "Texas Children's logo",
      },
      legal_disclaimer: "A single copy of these materials may be reprinted for noncommercial personal use only. “Texas Children’s,” “Texas Children’s Hospital,” “texaschildrens.org,” and the Texas Children’s logomark are trademarks of Texas Children’s Hospital.",
    }) }}
  {% endblock %}

  <script type="module" src="/tcds/dist/js/shared.js"></script>
  <script type="module" src="/tcds/dist/js/vendor.js"></script>
  <script type="module" src="/dist/js/playground.js"></script>

  {% for asset in get_assets() %}
    {% if asset ends with '.js' %}
      <script type="module" src="{{ asset }}"></script>
    {% endif %}
  {% endfor %}
</body>
</html>
