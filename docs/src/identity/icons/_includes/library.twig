<style>
.icon-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(13ch, 1fr));
  gap: var(--tcds-space-component-lg);
  margin: var(--tcds-space-layout-xs) 0 var(--tcds-space-layout-md);

  li {
    a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--tcds-space-component-md);
      padding: var(--tcds-space-component-md) 6px;
      border-radius: var(--tcds-border-radius-md);
      user-select: none;
      transition: all var(--tcds-motion-duration-productive) var(--tcds-motion-easing-enter);
      color: var(--tcds-color-theme-foreground);
      text-decoration: none;

      &:hover {
        background: var(--tcds-color-theme-warm-background);
        color: var(--tcds-color-theme-warm-accent);
      }

      &:active {
        scale: .95;
      }
    }
  }

  svg {
    width: 30%;
  }

  code {
    line-height: 1;
    white-space: nowrap;
  }
}
</style>

<code class="text-sm">icon.{{ category }}</code>
<ul role="list" class="icon-grid">
{% for icon, svg in tokens.icon[category] %}
<li>
  <a href="data:image/svg+xml;charset=utf-8,{{ svg["$value"] }}" download="{{ icon }}.svg" class="link--no-icon" title="Click to download {{ icon }}.svg">
    {{ svg["$value"] }}
    <code class="text-xs">{{ icon }}</code>
  </a>
</li>
{% endfor %}
</ul>
