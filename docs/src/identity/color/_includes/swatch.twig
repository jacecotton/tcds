<div class="flex flex--column lg:flex--row flex--no-wrap gap-lg">
<div style="flex: 1 0">
{% block content %}{% endblock %}
</div>
<div style="display: inline-flex; flex-shrink: 0" class="flex--column text-sm font-family-ui">
  <code class="flex-1">color.palette.{{ palette }}</code>
  <div class="gap-xs" style="display: grid; grid-template-columns: repeat(2, 125px)">
    {% for grade, color in tokens.color.palette[palette] %}
      <div class="flex flex--column gap-xs">
        <div style="background: var(--tcds-color-palette-{{ palette }}-{{ grade }}); width: 100%; height: 75px; border-radius: var(--tcds-border-radius-sm); display: flex; justify-content: center; align-items: center; color: var(--tcds-color-theme-{{ grade|number_format >= 500 ? 'dark' : 'neutral' }}-foreground)">
          <strong>{{ grade }}</strong>
        </div>
        <code style="color: var(--tcds-color-theme-muted); text-transform: uppercase">{{ color["$value"] }}</code>
      </div>
    {% endfor %}
  </div>
</div>
</div>
