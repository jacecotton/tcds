<style>
.corner-radius-demo {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--tcds-space-component-lg);
  text-align: center;
}

.corner-radius-demo figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--tcds-space-component-sm);
}

.corner-radius-demo .swatch {
  width: 100%;
  aspect-ratio: 3 / 2;
  border: 2px dashed var(--tcds-color-theme-edge);
}

.corner-radius-demo figcaption {
  font-family: var(--tcds-font-family-ui);
  font-size: var(--tcds-font-size-sm);
}
</style>

{% embed "tcds:callout" with {theme: "neutral"} %}
{% block content %}
<div class="corner-radius-demo">
  {% for size, value in tokens["border-radius"] %}
    {% if size != "$type" %}
      <figure>
        <div class="swatch" style="border-radius: var(--tcds-border-radius-{{ size }})"></div>
        <figcaption>
          <code>border-radius.{{ size }}</code><br>
          <span style="color: var(--tcds-color-theme-muted)">{{ value["$value"] }}</span>
        </figcaption>
      </figure>
    {% endif %}
  {% endfor %}
</div>
{% endblock %}
{% endembed %}
