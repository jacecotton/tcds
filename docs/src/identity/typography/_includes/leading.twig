<div style="margin-bottom: 1.5rem">
<label for="fontSize">Font size</label>
<select id="fontSize" name="fontSize" onchange="document.querySelectorAll('[data-font-size]').forEach(table => table.hidden = table.getAttribute('data-font-size') !== this.value)">
  {% for font_size, value in tokens.font.size %}
    {% if font_size != "$type" %}
      <option value="{{ font_size }}" {{ font_size == "md" ? "selected" }}>{{ value["$value"]|split("rem")[0]|number_format(5) * 16 }}px ({{ font_size|upper }})</option>
    {% endif %}
  {% endfor %}
</select>
</div>
{% embed "tcds:callout" with {theme: "neutral"} %}
{% block content %}
{% for font_size, value in tokens.font.size %}
{% if font_size != "$type" %}
<div style="display: flex; flex-direction: column; gap: 2.5rem" {{ font_size == "md" ? "" : "hidden" }} data-font-size="{{ font_size }}">
{% for line_height, value in tokens["line-height"] %}
{% if line_height != "$type" %}
{% apply spaceless %}
<div>
<code class="text-sm">line-height.{{ line_height }}</code>
<p style="font-size: var(--tcds-font-size-{{ font_size }}); line-height: var(--tcds-line-height-{{ line_height }}); position: relative; margin: 0 0 .75rem; white-space: nowrap">
{% set font_size_px = tokens.font.size[font_size]["$value"]|split("rem")[0]|number_format(5) * 16 %}
{% set line_box = font_size_px * value["$value"] %}
<span aria-hidden="true" style="display: inline-block; width: 0; height: 0; position: relative; vertical-align: baseline;"><span style="display: block; position: absolute; top: 0; left: -1rem; right: 0; height: {{ line_box + 1 }}px; border: 1px dashed var(--tcds-color-theme-warm-edge); border-right: 0; background: var(--tcds-color-theme-warm-background);"></span></span>
<span style="border-bottom: 1px dashed var(--tcds-color-theme-warm-edge); text-box: trim-both cap alphabetic; line-height: 1; display: inline-block">The quick brown fox jumps over the lazy sleeping dog</span><br>
<span style="border-bottom: 1px dashed var(--tcds-color-theme-warm-edge); text-box: trim-both cap alphabetic; line-height: 1; display: inline-block">The quick brown fox jumps over the lazy sleeping dog</span>
</p>
<code class="text-xs"><span style="color: var(--tcds-color-theme-muted)">{{ font_size_px }}px&nbsp;&times;</span>&nbsp;{{ value["$value"] }}&nbsp;<span style="color: var(--tcds-color-theme-muted)">=&nbsp;{{ line_box }}px</span></code>
</div>
{% endapply %}
{% endif %}
{% endfor %}
</div>
{% endif %}
{% endfor %}
{% endblock %}
{% endembed %}
