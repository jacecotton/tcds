<style>
.type-scale-callout {
  dl {
    display: flex;
    flex-direction: column;
    gap: var(--tcds-space-component-lg);
  }

  dd {
    display: flex;
    justify-content: space-between;
    align-items: end;
    border-bottom: 1px dashed var(--tcds-color-theme-edge);
    padding: var(--tcds-space-component-sm) 0 0;

    span {
      display: inline-block;
      position: relative;
      width: 100%;
      max-width: 700px;
      white-space: nowrap;
      overflow: clip visible;
      text-box: trim-both cap alphabetic;

      &::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 10%;
        background: linear-gradient(to right, transparent 0%, var(--tcds-color-theme-background) 90%);
      }
    }

    code {
      display: inline-block;
      white-space: nowrap;
      text-box: trim-both cap alphabetic;
      padding-bottom: 4px;
    }
  }
}
</style>

{% embed "tcds:callout" with {
  custom_classes: ["type-scale-callout"],
  theme: "neutral",
} %}
{% block content %}
<dl>
  {% for token, data in tokens.font.size %}
    {% if data["$value"] %}
      <div>
        <dt><code class="text-sm">font.size.{{ token }}</code></dt>
        <dd>
          <span aria-hidden="true" class="text-{{ token }}" contenteditable spellcheck="false">
            The quick brown fox jumps over the lazy sleeping dog.
          </span>
          <code class="text-sm">
            {{ data["$value"] }}
            / {{ data["$value"]|split("rem")[0]|number_format(5) * 16 }}px
          </code>
        </dd>
      </div>
    {% endif %}
  {% endfor %}
</dl>
{% endblock %}
{% endembed %}
