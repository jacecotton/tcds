<style>
.breakpoint-demo .bar-row {
  display: flex;
  align-items: center;
  gap: var(--tcds-space-component-md);
  margin-bottom: var(--tcds-space-component-sm);
}

.breakpoint-demo .bar {
  height: 12px;
  background: var(--tcds-color-palette-blue-100);
  border: 1px solid var(--tcds-color-palette-blue-200);
  border-radius: var(--tcds-border-radius-xs);
  position: relative;
}

.breakpoint-demo .label {
  font-family: var(--tcds-font-family-ui);
  font-size: var(--tcds-font-size-sm);
  white-space: nowrap;
  min-width: 180px;
}

.breakpoint-demo .value {
  color: var(--tcds-color-theme-muted);
  font-size: var(--tcds-font-size-xs);
}
</style>

{% embed "tcds:callout" with {theme: "neutral"} %}
{% block content %}
<div class="breakpoint-demo">
  {% set max_px = 1920 %}
  {% for size, value in tokens.size.breakpoint %}
    {% if size != "$description" %}
      {% set px = value["$value"]|replace({"px": ""})|number_format %}
      <div class="bar-row">
        <span class="label"><code>size.breakpoint.{{ size }}</code> <span class="value">{{ value["$value"] }}</span></span>
        <div class="bar" style="width: {{ (px / max_px * 100) }}%"></div>
      </div>
    {% endif %}
  {% endfor %}
</div>
{% endblock %}
{% endembed %}
