<style>
.aspect-ratio-demo {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--tcds-space-component-lg);
  text-align: center;
}

.aspect-ratio-demo figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--tcds-space-component-sm);
}

.aspect-ratio-demo .swatch {
  width: 100%;
  background: var(--tcds-color-theme-faded);
  border: 1px solid var(--tcds-color-theme-edge);
  border-radius: var(--tcds-border-radius-sm);
}

.aspect-ratio-demo figcaption {
  font-family: var(--tcds-font-family-ui);
  font-size: var(--tcds-font-size-sm);
}
</style>

{% embed "tcds:callout" with {theme: "neutral"} %}
{% block content %}
<div class="aspect-ratio-demo">
  {% for name, value in tokens["aspect-ratio"] %}
    {% if name != "$type" and name != "$description" %}
      <figure>
        <div class="swatch" style="aspect-ratio: {{ value['$value']|replace({"'": ""}) }}"></div>
        <figcaption>
          <code>aspect-ratio.{{ name }}</code><br>
          <span style="color: var(--tcds-color-theme-muted)">{{ value["$value"]|replace({"'": ""}) }}</span>
        </figcaption>
      </figure>
    {% endif %}
  {% endfor %}
</div>
{% endblock %}
{% endembed %}
